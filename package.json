{
  "name": "mmy-css",
  "version": "1.0.0",
  "description": "A modern, lightweight, fast-loading CSS framework.",
  "main": "dist/mmy.css",
  "style": "dist/mmy.css",
  "exports": {
    ".": {
      "style": "./dist/mmy.css",
      "default": "./dist/mmy.css"
    },
    "./dist/": "./dist/"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:unminified": "lightningcss --bundle --targets \">= 0.25%\" src/index.css -o dist/mmy.css",
    "build:minified": "lightningcss --bundle --minify --targets \">= 0.25%\" src/index.css -o dist/mmy.min.css",    "build": "npm run build:unminified && npm run build:minified",
    "watch": "chokidar \"src/**/*.css\" -c \"npm run build\"",
    "serve": "live-server --watch=dist,index.html",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "css-framework",
    "mmy-css",
    "responsive",
    "flexbox",
    "grid",
    "ui-kit",
    "lightweight-css",
    "design-system"
  ],
  "author": "Muhammad maulana Yusuf <mmaulanayusuf777@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmy-lana/mmy-css.git"
  },
  "bugs": {
    "url": "https://github.com/mmy-lana/mmy-css/issues"
  },
  "homepage": "https://github.com/mmy-lana/mmy-css#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "lightningcss-cli": "^1.33.0",
    "live-server": "^1.2.2"
  }
}
